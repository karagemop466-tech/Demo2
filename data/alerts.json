 "model": {
  "name": "Jump Edge Score",
  "version": "1.0",
  "kind": "deterministic rule-based ranking (no trained weights, no forecast)",
  "threshold_dollars": 0.1,
  "score_formula": "score = 0.30*momentum + 0.20*conviction + 0.20*liquidity + 0.15*efficiency + 0.15*proximity   (each component 0..1)",
  "components": {
   "momentum": "min(|change| / 0.40, 1)",
   "conviction": "min(open_interest_fp / 1000, 1)",
   "liquidity": "min(contracts resting at the best YES bid / 100, 1)",
   "efficiency": "1 - min(spread / 0.20, 1), spread = yes_ask_dollars - yes_bid_dollars",
   "proximity": "1 - min(days_to_close / 180, 1)"
  },
  "normalisation": "Each raw component is converted to its percentile inside the current alert set before weighting, so the score ranks the alerts against each other instead of against a fixed constant. A component the API did not return is excluded and the remaining weights are renormalised; a missing component can therefore never make an alert score higher.",
  "weights": {
   "momentum": 0.3,
   "conviction": 0.2,
   "liquidity": 0.2,
   "efficiency": 0.15,
   "proximity": 0.15
  },
  "roi_definition": "Conditional reversion ROI. After a move to price p1 the contrarian side is bought at p1 (YES after a down move) or 1 - p1 (NO after an up move). If the price reverted to the pre-move price p0 the gross return would be |p1 - p0| / price_paid. roi_net subtracts the fee drag 0.07 * (1 - price_paid). This is a size of the opportunity if reversion happens, NOT a probability and NOT a return forecast.",
  "depth_definition": "depth_at_entry is the number of contracts the official order book offers within +/- $0.02 of the price you would have to pay. To buy YES at price p you lift the YES ask side, which is derived from NO bids at 1 - p; to buy NO at price q you hit the YES bid side at 1 - q. The book returns bids only, so the ask side is derived (1 - bid) and labelled as derived everywhere.",
  "fee_model": {
   "formula": "fee_per_contract = 0.07 * P * (1 - P)  (taker, 1 contract)",
   "source": "https://kalshi.com/fee-schedule",
   "note": "Reconstructed from the officially published per-100-contract fee range $0.07-$1.75; both endpoints match exactly. The published page is the authority; the parabola is this project's assumption."
  },
  "pick_rule": "score >= 0.6 and roi_net >= 0.1 and depth_at_entry >= 10 contracts and |change| >= 0.10 and both prices of the move inside 0.05-0.95",
  "caveats": [
   "The score ranks where attention is worth spending. It does not predict direction and it does not forecast a return.",
   "The Kalshi demo environment uses mock funds and its prices and behaviour may not reflect real markets (https://docs.kalshi.com/getting_started/demo_env), so no score or ROI here transfers to the live exchange.",
   "The cause of a price move is not in the API. Each alert links the market's own declared settlement sources and is flagged 'cause unverified'.",
   "Liquidity and spread are read from the order book at collection time; they are stale by the time the page renders and are labelled with their source."
  ],
