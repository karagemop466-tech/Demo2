# Machine-written data snapshots are produced by the refresh workflows and committed
# deliberately (they are the site's evidence trail). Nothing else belongs here.
node_modules/
__pycache__/
*.pyc
dist/
_site/
*.log
.DS_Store
.env
.env.*
*.log

# The full snapshot is 12 MB of raw provenance; the site reads dashboard_meta.json,
# top.json, resolutions.json, liquidity.json and snapshot_api_log.json instead.
# The workflow keeps it as a run artifact.
data/snapshot.json
