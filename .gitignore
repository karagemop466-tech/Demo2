# Machine-written data snapshots are produced by the refresh workflows and committed
# deliberately (they are the site's evidence trail). Nothing else belongs here.
node_modules/
__pycache__/
*.pyc
dist/
_site/
*.log
.DS_Store
.env
.env.*
*.log

# Full collected universe: evidence trail kept as the Actions run artifact, never
# committed (it is what blew through GitHub's 100 MB per-file push limit on 2026-11-20).
/data/out/
